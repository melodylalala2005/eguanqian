# 复制本文件为 .env 后按需修改
cp .env.example .env

# Qwen / DashScope 密钥也可直接放这里（与 apis.json 二选一）
DASHSCOPE_API_KEY=""

# SQLite 数据库配置（可选，默认 bills/bills.db）
DB_FILE="bills/bills.db"

# 密码加密盐值（可选，建议改成你自己的随机串）
PASSWORD_SALT="smartledger_default_salt"

# 开发用万能 token（仅本地联调，生产环境留空）
# DEV_BYPASS_TOKEN=""

# 服务配置
UVICORN_HOST="0.0.0.0"
UVICORN_PORT="8000"
